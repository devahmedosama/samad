# Laravel
/vendor/
/.env
.env.*
.phpunit.result.cache
Homestead.yaml
Homestead.json

# Laravel storage (except .gitkeep)
storage/
!storage/*.gitkeep

# Laravel specific folders to ignore
/storage/logs/
/storage/framework/cache/
/storage/framework/sessions/
/storage/framework/views/
/storage/framework/testing/
/storage/debugbar/

# Uploads and media
/uploads/
!/uploads/.gitkeep

# Node
/node_modules/
npm-debug.log
yarn-error.log

# IDEs and editors
/.idea/
/.vscode/
*.sublime-project
*.sublime-workspace

# Mac system files
.DS_Store

# Windows system files
Thumbs.db
ehthumbs.db

# Others
*.swp
*.swo

# Git itself
.gitignore

# Build or database files (optional)
build/
hot/
*.sql
*.sqlite
*.sqlite3

# Optional if used
.fleet/
.phpunit.cache
